# Abutron ADVL Step 2A - dxFeed Market Indicators
# Production credentials come from your dxFeed onboarding/welcome letter.

DXFEED_MODE=demo
DXFEED_REST_URL=https://tools.dxfeed.com/webservice/rest/events.json
DXFEED_TOKEN=
DXFEED_USERNAME=
DXFEED_PASSWORD=

# Composite market indicators: all CTA/UTP participants for NYSE/Nasdaq-listed stocks.
DXFEED_NYSE_UP_SYMBOL=$UVOLC
DXFEED_NYSE_DOWN_SYMBOL=$DVOLC
DXFEED_NASDAQ_UP_SYMBOL=$UVOLC/Q
DXFEED_NASDAQ_DOWN_SYMBOL=$DVOLC/Q

DXFEED_POLL_SECONDS=5
DXFEED_WINDOW_SECONDS=180
DXFEED_REQUEST_TIMEOUT_SECONDS=10
DXFEED_MAX_EVENT_AGE_SECONDS=30
DXFEED_MAX_COMPONENT_SKEW_SECONDS=20
DXFEED_MAX_BASELINE_GAP_SECONDS=30

# Safety: demo/delayed data is never written into Kronos by default.
DXFEED_ALLOW_DELAYED_DEMO_WRITE=false

DXFEED_SOURCE_LABEL=DXFEED_MARKET_INDICATORS
DXFEED_UNIVERSE_LABEL=NYSE+NASDAQ_COMPOSITE
