def out(key, value):
    print(f"{key}={value}", flush=True)


def resolve_path(value: str) -> Path:
    p = Path(value)
    if not p.is_absolute():
        p = ROOT / p
    return p.resolve()


def platform_url():
    return make_url(str(core_settings.platform_db_url))


def platform_backend() -> str:
    return str(platform_url().drivername)


def platform_sqlite_path() -> Path:
    url = platform_url()
    if not url.drivername.startswith("sqlite"):
        raise RuntimeError(
            f"Platform backend is not SQLite: {url.drivername}"
        )
    if not url.database:
        raise RuntimeError("SQLite platform database path is empty.")
    return resolve_path(url.database)


def is_platform_postgres() -> bool:
    return platform_url().drivername.startswith("postgresql")

def decision_db_path() -> Path:
    return resolve_path(str(core_settings.decision_db))


def bridge_db_path() -> Path:
    return resolve_path(str(bridge_settings.idempotency_db))


def sqlite_connect(path: Path):
    return sqlite3.connect(str(path), timeout=30)


def sqlite_integrity(path: Path) -> str:
    if not path.exists():
        raise RuntimeError(f"SQLite database missing: {path}")
    with sqlite_connect(path) as db:
        row = db.execute("PRAGMA integrity_check").fetchone()
    return str(row[0]) if row else ""


def sqlite_tables(path: Path) -> list[str]:
    with sqlite_connect(path) as db:
        return [
            str(r[0])
            for r in db.execute(
                "SELECT name FROM sqlite_master "
                "WHERE type='table' AND name NOT LIKE 'sqlite_%' "
                "ORDER BY name"
            ).fetchall()
        ]


def qident(name: str) -> str:
    return '"' + str(name).replace('"', '""') + '"'


def sqlite_table_counts(path: Path) -> dict[str, int]:
    result = {}
    with sqlite_connect(path) as db:
        for table in sqlite_tables(path):
            row = db.execute(f"SELECT COUNT(*) FROM {qident(table)}").fetchone()
            result[table] = int(row[0]) if row else 0
    return result


def marker_count_sqlite(path: Path, marker: str) -> int:
    total = 0
    with sqlite_connect(path) as db:
        for table in sqlite_tables(path):
            cols = [
                str(r[1])
                for r in db.execute(
                    f"PRAGMA table_info({qident(table)})"
                ).fetchall()
            ]
            if not cols:
                continue
            where = " OR ".join(
                f"CAST({qident(c)} AS TEXT) LIKE ?" for c in cols
            )
            params = [f"%{marker}%"] * len(cols)
            row = db.execute(
                f"SELECT COUNT(*) FROM {qident(table)} WHERE {where}",
                params,
            ).fetchone()
            total += int(row[0]) if row else 0
    return total


def delete_marker_sqlite(path: Path, marker: str) -> int:
    deleted = 0
    with sqlite_connect(path) as db:
        for table in sqlite_tables(path):
            cols = [
                str(r[1])
                for r in db.execute(
                    f"PRAGMA table_info({qident(table)})"
                ).fetchall()
            ]
            if not cols:
                continue
            where = " OR ".join(
                f"CAST({qident(c)} AS TEXT) LIKE ?" for c in cols
            )
            params = [f"%{marker}%"] * len(cols)
            cur = db.execute(
                f"DELETE FROM {qident(table)} WHERE {where}",
                params,
            )
            if cur.rowcount and cur.rowcount > 0:
                deleted += int(cur.rowcount)
        db.commit()
    return deleted


def sqlite_backup(source: Path, dest: Path):
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        dest.unlink()
    with sqlite_connect(source) as src, sqlite_connect(dest) as dst:
        src.backup(dst)
        dst.commit()


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def postgres_tools() -> dict[str, Path]:
    candidates = []

    for name in ("pg_dump.exe", "pg_restore.exe", "psql.exe"):
        found = shutil.which(name)
        if found:
            candidates.append(Path(found).parent)

    program_files = Path(os.environ.get("ProgramFiles", r"C:\Program Files"))
    pg_root = program_files / "PostgreSQL"
    if pg_root.exists():
        for child in sorted(pg_root.iterdir(), reverse=True):
            bin_dir = child / "bin"
            if bin_dir.exists():
                candidates.append(bin_dir)

    seen = set()
    for base in candidates:
        key = str(base).lower()
        if key in seen:
            continue
        seen.add(key)
        tools = {
            "pg_dump": base / "pg_dump.exe",
            "pg_restore": base / "pg_restore.exe",
            "psql": base / "psql.exe",
        }
        if all(path.exists() for path in tools.values()):
            return tools

    raise RuntimeError("PostgreSQL client tools pg_dump/pg_restore/psql were not found.")


def postgres_env_and_args(dbname: str | None = None):
    url = platform_url()
    if not url.drivername.startswith("postgresql"):
        raise RuntimeError("PostgreSQL helper called for non-PostgreSQL backend.")

    if not url.username:
        raise RuntimeError("PostgreSQL username is missing from platform DB URL.")
    if url.password is None:
        raise RuntimeError("PostgreSQL password is missing from platform DB URL.")
    if not url.database:
        raise RuntimeError("PostgreSQL database name is missing from platform DB URL.")

    env = os.environ.copy()
    env["PGPASSWORD"] = str(url.password)

    host = str(url.host or "127.0.0.1")
    port = str(url.port or 5432)
    database = str(dbname or url.database)

    args = [
        "--no-password",
        "--host", host,
        "--port", port,
        "--username", str(url.username),
        "--dbname", database,
    ]
    return env, args


def run_pg(cmd: list[str], env: dict[str, str], label: str):
    result = subprocess.run(
        cmd,
        env=env,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if result.returncode != 0:
        # Do not include the command because it may contain connection metadata.
        detail = (result.stderr or result.stdout or "").strip()
        if len(detail) > 1600:
            detail = detail[-1600:]
        raise RuntimeError(f"{label} failed (exit={result.returncode}): {detail}")
    return result


def postgres_table_names(schema: str = "public") -> list[str]:
    sql = text(
        "SELECT table_name FROM information_schema.tables "
        "WHERE table_schema=:schema AND table_type='BASE TABLE' "
        "ORDER BY table_name"
    )
    with platform_engine.connect() as conn:
        return [str(r[0]) for r in conn.execute(sql, {"schema": schema}).fetchall()]


def postgres_schema_counts(schema: str) -> dict[str, int]:
    result: dict[str, int] = {}
    for table_name in postgres_table_names(schema):
        with platform_engine.connect() as conn:
            value = conn.exec_driver_sql(
                f"SELECT COUNT(*) FROM {qident(schema)}.{qident(table_name)}"
            ).scalar_one()
        result[table_name] = int(value)
    return result


def remap_public_dump(sql_text: str, target_schema: str) -> str:
    qtarget = qident(target_schema)

    # pg_dump output is deterministic about schema qualification. Replace both
    # quoted and unquoted public qualification, including regclass literals.
    remapped = sql_text.replace('"public".', qtarget + ".")
    remapped = remapped.replace("public.", qtarget + ".")

    remapped = re.sub(
        r"(?m)^CREATE SCHEMA public;\\s*$",
        f"CREATE SCHEMA {qtarget};",
        remapped,
    )
    remapped = re.sub(
        r"(?m)^COMMENT ON SCHEMA public ",
        f"COMMENT ON SCHEMA {qtarget} ",
        remapped,
    )
    remapped = remapped.replace(
        "SET search_path = public, pg_catalog;",
        f"SET search_path = {qtarget}, pg_catalog;",
    )
    remapped = remapped.replace(
        'SET search_path = "public", pg_catalog;',
        f"SET search_path = {qtarget}, pg_catalog;",
    )

    if f"CREATE SCHEMA {qtarget};" not in remapped:
        remapped = f"CREATE SCHEMA {qtarget};\\nSET search_path = {qtarget}, pg_catalog;\\n" + remapped

    return remapped


def postgres_backup_restore_drill(backup_dir: Path, marker: str):
    tools = postgres_tools()
    env, conn_args = postgres_env_and_args()
    backup_dir.mkdir(parents=True, exist_ok=True)

    archive = backup_dir / "platform_postgresql.dump"
    raw_sql = backup_dir / "platform_restore_raw.sql"
    remapped_sql = backup_dir / "platform_restore_remapped.sql"

    if archive.exists():
        archive.unlink()

    dump_cmd = [
        str(tools["pg_dump"]),
        *conn_args,
        "--format=custom",
        "--no-owner",
        "--no-privileges",
        "--schema=public",
        "--file", str(archive),
    ]
    run_pg(dump_cmd, env, "pg_dump")

    if not archive.exists() or archive.stat().st_size <= 0:
        raise RuntimeError("PostgreSQL backup archive was not created.")

    list_cmd = [str(tools["pg_restore"]), "--list", str(archive)]
    listed = run_pg(list_cmd, env, "pg_restore --list")
    if "TABLE" not in listed.stdout.upper():
        raise RuntimeError("PostgreSQL archive listing contains no tables.")

    restore_sql_cmd = [
        str(tools["pg_restore"]),
        "--no-owner",
        "--no-privileges",
        "--file", str(raw_sql),
        str(archive),
    ]
    run_pg(restore_sql_cmd, env, "pg_restore SQL extraction")

    if not raw_sql.exists() or raw_sql.stat().st_size <= 0:
        raise RuntimeError("PostgreSQL restore SQL extraction failed.")

    schema_suffix = re.sub(r"[^a-z0-9]", "", marker.lower())[-18:]
    restore_schema = "step15_restore_" + schema_suffix

    raw = raw_sql.read_text(encoding="utf-8", errors="replace")
    remapped = remap_public_dump(raw, restore_schema)
    remapped_sql.write_text(remapped, encoding="utf-8")

    live_counts = postgres_schema_counts("public")
    if not live_counts:
        raise RuntimeError("PostgreSQL public schema contains no base tables.")

    try:
        with platform_engine.begin() as conn:
            conn.exec_driver_sql(f"DROP SCHEMA IF EXISTS {qident(restore_schema)} CASCADE")

        psql_cmd = [
            str(tools["psql"]),
            *conn_args,
            "--set", "ON_ERROR_STOP=1",
            "--file", str(remapped_sql),
        ]
        run_pg(psql_cmd, env, "PostgreSQL temporary-schema restore")

        restored_counts = postgres_schema_counts(restore_schema)
        if restored_counts != live_counts:
            missing = sorted(set(live_counts) - set(restored_counts))
            extra = sorted(set(restored_counts) - set(live_counts))
            mismatched = sorted(
                k for k in set(live_counts).intersection(restored_counts)
                if live_counts[k] != restored_counts[k]
            )
            raise RuntimeError(
                "PostgreSQL restored schema count mismatch; "
                f"missing={missing} extra={extra} mismatched={mismatched}"
            )

        out("PLATFORM_POSTGRES_ARCHIVE_SHA256", sha256(archive))
        out("PLATFORM_POSTGRES_TABLE_COUNT", len(live_counts))
        out("PLATFORM_POSTGRES_RESTORE_COUNT_PARITY", "PASS")
        out("POSTGRES_BACKUP_RESTORE_DRILL", "PASS")
    finally:
        try:
            with platform_engine.begin() as conn:
                conn.exec_driver_sql(
                    f"DROP SCHEMA IF EXISTS {qident(restore_schema)} CASCADE"
                )
        finally:
            # Extracted SQL contains production data in plaintext. Do not retain it.
            for path in (raw_sql, remapped_sql):
                try:
                    if path.exists():
                        path.unlink()
                except Exception:
                    pass


def platform_counts() -> dict[str, int]:
    names = (
        "users",
        "trading_accounts",
        "licenses",
        "subscriptions",
        "trade_records",
        "notifications",
        "audit_events",
    )
    insp = inspect(platform_engine)
    existing = set(insp.get_table_names())
    result = {}
    with platform_engine.connect() as conn:
        for name in names:
            if name not in existing:
                raise RuntimeError(f"Required platform table missing: {name}")
            result[name] = int(
                conn.exec_driver_sql(
                    f"SELECT COUNT(*) FROM {qident(name)}"
                ).scalar_one()
            )
    return result


def audit_count(action: str, subject: str) -> int:
    with session_scope() as s:
        return int(
            s.scalar(
                select(func.count())
                .select_from(AuditEvent)
                .where(
                    AuditEvent.action == action,
                    AuditEvent.subject == subject,
                )
            )
            or 0
        )


def trade_marker_count(ticket: str) -> int:
    with session_scope() as s:
        return int(
            s.scalar(
                select(func.count())
                .select_from(TradeRecord)
                .where(
                    TradeRecord.ticket == ticket,
                    TradeRecord.state == "OPENED",
                )
            )
            or 0
        )


def make_ticket(marker: str) -> str:
    digest = hashlib.sha256(marker.encode("utf-8")).hexdigest()
    # Numeric string only, to mirror broker-ticket shape while being
    # recognizably outside the real broker path.
    return str(990000000000 + (int(digest[:10], 16) % 9000000000))


def create_markers(marker: str):
    store = DecisionStore()
    payload = {
        "step15_marker": marker,
        "certification": True,
        "note": "synthetic persistence marker; no broker execution",
    }
    store.add(
        f"STEP15_{marker[-12:]}",
        "FUSION",
        "HOLD",
        0.0,
        False,
        "STEP15_CERTIFICATION",
        payload,
    )

    decision_count = marker_count_sqlite(decision_db_path(), marker)
    if decision_count < 1:
        raise RuntimeError("DecisionStore marker was not persisted.")

    if audit_count("STEP15_PERSISTENCE_PROBE", marker) == 0:
        with session_scope() as s:
            s.add(
                AuditEvent(
                    actor="step15-cert",
                    action="STEP15_PERSISTENCE_PROBE",
                    subject=marker,
                    detail="Synthetic persistence marker. No trading action.",
                )
            )

    ticket = make_ticket(marker)

    # Resolve the exact active platform account.
    # Fail closed instead of guessing or selecting the first customer.
    with session_scope() as s:
        accounts = list(
            s.scalars(
                select(TradingAccount)
                .where(
                    TradingAccount.active == True
                )
                .order_by(
                    TradingAccount.id.asc()
                )
            ).all()
        )

        if len(accounts) != 1:
            raise RuntimeError(
                "STEP15 requires exactly one active TradingAccount "
                "for the synthetic reconciliation drill; "
                f"found={len(accounts)}"
            )

        account_login = str(
            accounts[0].login or ""
        ).strip()

        account_server = str(
            accounts[0].server or ""
        ).strip()

    if not account_login:
        raise RuntimeError(
            "STEP15 active TradingAccount has no login."
        )

    fake_deal = {
        # Deal ticket and position ticket are intentionally distinct,
        # exactly like the current production reconciliation model.
        "ticket": int(ticket) + 1,
        "position_id": int(ticket),
        "entry": 0,
        "type": 0,
        "symbol": "STEP15CERT",
        "volume": 0.0,
        "price": 0.0,
        "profit": 0.0,
        "commission": 0.0,
        "swap": 0.0,
        "fee": 0.0,
        "time": int(time.time()),

        # Current worker accepts only Abutron-owned reconciliation deals.
        "magic": int(bridge_settings.magic),
        "comment": "ABUTRON STEP15 CERT",
    }

    # Run reconciliation twice. The second call must not duplicate the row.
    sync_deals(
        [fake_deal],
        account_login,
        account_server,
    )

    sync_deals(
        [fake_deal],
        account_login,
        account_server,
    )

    tc = trade_marker_count(ticket)
    if tc != 1:
        raise RuntimeError(
            f"sync_deals idempotency failed for certification row; count={tc}"
        )

    bridge_store = IdempotencyStore()
    if not hasattr(bridge_store, "claim"):
        raise RuntimeError("Bridge execution-claim hardening is missing.")
    if not hasattr(bridge_store, "claim_exists"):
        raise RuntimeError("Bridge claim_exists hardening is missing.")
    if not hasattr(bridge_store, "release_claim"):
        raise RuntimeError("Bridge release_claim hardening is missing.")

    claim_key = "STEP15:" + marker
    if bridge_store.claim_exists(claim_key):
        bridge_store.release_claim(claim_key)

    first = bool(bridge_store.claim(claim_key))
    second = bool(bridge_store.claim(claim_key))

    if not first:
        raise RuntimeError("Initial bridge execution claim was not acquired.")
    if second:
        raise RuntimeError("Duplicate bridge execution claim was incorrectly acquired.")
    if not bridge_store.claim_exists(claim_key):
        raise RuntimeError("Bridge execution claim was not persisted.")

    out("DECISION_MARKER_PERSISTED", "PASS")
    out("AUDIT_MARKER_PERSISTED", "PASS")
    out("SYNC_DEALS_DUPLICATE_SUPPRESSION", "PASS")
    out("TRADE_MARKER_TICKET", ticket)
    out("BRIDGE_CLAIM_FIRST", first)
    out("BRIDGE_CLAIM_DUPLICATE_BLOCKED", not second)
    out("BRIDGE_CLAIM_PERSISTED", "PASS")


def verify_markers(marker: str):
    dc = marker_count_sqlite(decision_db_path(), marker)
    ac = audit_count("STEP15_PERSISTENCE_PROBE", marker)
    tc = trade_marker_count(make_ticket(marker))
    claim_key = "STEP15:" + marker
    bridge_store = IdempotencyStore()
    cc = bool(bridge_store.claim_exists(claim_key))

    out("DECISION_MARKER_COUNT", dc)
    out("AUDIT_MARKER_COUNT", ac)
    out("TRADE_MARKER_COUNT", tc)
    out("BRIDGE_CLAIM_EXISTS", cc)

    if dc < 1:
        raise RuntimeError("Decision marker did not survive restart.")
    if ac != 1:
        raise RuntimeError(f"Audit marker count invalid after restart: {ac}")
    if tc != 1:
        raise RuntimeError(f"Trade reconciliation marker count invalid after restart: {tc}")
    if not cc:
        raise RuntimeError("Bridge execution claim did not survive restart.")

    out("PERSISTENCE_AFTER_RESTART", "PASS")


def cleanup_markers(marker: str):
    deleted_decisions = delete_marker_sqlite(decision_db_path(), marker)

    with session_scope() as s:
        s.execute(
            delete(TradeRecord).where(
                TradeRecord.ticket == make_ticket(marker),
                TradeRecord.state == "OPENED",
            )
        )
        s.execute(
            delete(AuditEvent).where(
                AuditEvent.action == "STEP15_PERSISTENCE_PROBE",
                AuditEvent.subject == marker,
            )
        )

    bridge_store = IdempotencyStore()
    bridge_store.release_claim("STEP15:" + marker)

    out("DECISION_MARKERS_DELETED", deleted_decisions)
    out("SYNTHETIC_TRADE_MARKER_CLEANED", "PASS")
    out("PERSISTENCE_PROBE_AUDIT_CLEANED", "PASS")
    out("BRIDGE_CLAIM_CLEANED", "PASS")


def final_audit(marker: str):
    if audit_count("STEP15_CERTIFIED", marker) == 0:
        with session_scope() as s:
            s.add(
                AuditEvent(
                    actor="step15-cert",
                    action="STEP15_CERTIFIED",
                    subject=marker,
                    detail=(
                        "Database/audit persistence, restart reconciliation, "
                        "idempotency and mixed-backend backup/restore drill passed. "
                        "No trading action performed."
                    ),
                )
            )

    count = audit_count("STEP15_CERTIFIED", marker)
    if count != 1:
        raise RuntimeError(f"Final STEP15_CERTIFIED audit count invalid: {count}")

    out("FINAL_AUDIT_EVENT", "PASS")


def verify_final(marker: str):
    dc = marker_count_sqlite(decision_db_path(), marker)
    tc = trade_marker_count(make_ticket(marker))
    probe_ac = audit_count("STEP15_PERSISTENCE_PROBE", marker)
    cert_ac = audit_count("STEP15_CERTIFIED", marker)
    claim_exists = bool(
        IdempotencyStore().claim_exists("STEP15:" + marker)
    )

    out("FINAL_DECISION_MARKER_COUNT", dc)
    out("FINAL_TRADE_MARKER_COUNT", tc)
    out("FINAL_PROBE_AUDIT_COUNT", probe_ac)
    out("FINAL_CERT_AUDIT_COUNT", cert_ac)
    out("FINAL_BRIDGE_CLAIM_EXISTS", claim_exists)

    if dc != 0:
        raise RuntimeError("Synthetic decision marker cleanup failed.")
    if tc != 0:
        raise RuntimeError("Synthetic trade marker cleanup failed.")
    if probe_ac != 0:
        raise RuntimeError("Synthetic probe audit cleanup failed.")
    if cert_ac != 1:
        raise RuntimeError("Final audit certification event missing.")
    if claim_exists:
        raise RuntimeError("Synthetic bridge claim cleanup failed.")

    out("SYNTHETIC_STATE_CLEANUP", "PASS")
    out("AUDIT_CERTIFICATION_RETAINED", "PASS")


def backup_restore_drill(marker: str, backup_dir: Path):
    sqlite_paths = {
        "decision": decision_db_path(),
        "bridge": bridge_db_path(),
    }

    for name, src in sqlite_paths.items():
        if sqlite_integrity(src).lower() != "ok":
            raise RuntimeError(f"{name} live SQLite integrity check failed.")

    live_counts = {
        name: sqlite_table_counts(path)
        for name, path in sqlite_paths.items()
    }

    backup_dir.mkdir(parents=True, exist_ok=True)
    restore_dir = backup_dir / "restore_drill"
    restore_dir.mkdir(parents=True, exist_ok=True)

    for name, src in sqlite_paths.items():
        backup_path = backup_dir / f"{name}.sqlite3"
        restore_path = restore_dir / f"{name}.sqlite3"

        sqlite_backup(src, backup_path)
        sqlite_backup(backup_path, restore_path)

        if sqlite_integrity(backup_path).lower() != "ok":
            raise RuntimeError(f"{name} backup integrity check failed.")
        if sqlite_integrity(restore_path).lower() != "ok":
            raise RuntimeError(f"{name} restored-copy integrity check failed.")

        restore_counts = sqlite_table_counts(restore_path)
        if restore_counts != live_counts[name]:
            raise RuntimeError(
                f"{name} restored-copy table-count mismatch."
            )

        out(f"{name.upper()}_BACKUP_SHA256", sha256(backup_path))
        out(f"{name.upper()}_RESTORE_SHA256", sha256(restore_path))
        out(f"{name.upper()}_RESTORE_COUNT_PARITY", "PASS")

    out("SQLITE_BACKUP_RESTORE_DRILL", "PASS")

    backend = platform_backend()
    if backend.startswith("sqlite"):
        src = platform_sqlite_path()
        if sqlite_integrity(src).lower() != "ok":
            raise RuntimeError("platform live SQLite integrity check failed.")
        live = sqlite_table_counts(src)
        backup_path = backup_dir / "platform.sqlite3"
        restore_path = restore_dir / "platform.sqlite3"
        sqlite_backup(src, backup_path)
        sqlite_backup(backup_path, restore_path)
        if sqlite_integrity(restore_path).lower() != "ok":
            raise RuntimeError("platform restored-copy integrity check failed.")
        if sqlite_table_counts(restore_path) != live:
            raise RuntimeError("platform restored-copy table-count mismatch.")
        out("PLATFORM_BACKUP_SHA256", sha256(backup_path))
        out("PLATFORM_RESTORE_SHA256", sha256(restore_path))
        out("PLATFORM_RESTORE_COUNT_PARITY", "PASS")
    elif backend.startswith("postgresql"):
        postgres_backup_restore_drill(backup_dir, marker)
    else:
        raise RuntimeError(f"Unsupported platform database backend: {backend}")

    out("DATABASE_BACKUP_RESTORE_DRILL", "PASS")

def inventory():
    dp = decision_db_path()
    bp = bridge_db_path()

    for name, path in (
        ("decision", dp),
        ("bridge", bp),
    ):
        result = sqlite_integrity(path)
        out(f"{name.upper()}_DB_INTEGRITY", result)
        if result.lower() != "ok":
            raise RuntimeError(f"{name} database integrity failed.")

    backend = platform_backend()
    if backend.startswith("sqlite"):
        pp = platform_sqlite_path()
        result = sqlite_integrity(pp)
        out("PLATFORM_DB_INTEGRITY", result)
        if result.lower() != "ok":
            raise RuntimeError("platform SQLite integrity failed.")
        out("PLATFORM_DB_BACKEND", "sqlite")
    elif backend.startswith("postgresql"):
        with platform_engine.connect() as conn:
            one = conn.exec_driver_sql("SELECT 1").scalar_one()
            dbname = conn.exec_driver_sql("SELECT current_database()").scalar_one()
            dbuser = conn.exec_driver_sql("SELECT current_user").scalar_one()
        if int(one) != 1:
            raise RuntimeError("PostgreSQL SELECT 1 health check failed.")
        out("PLATFORM_DB_BACKEND", "postgresql")
        out("PLATFORM_POSTGRES_CONNECTIVITY", "PASS")
        out("PLATFORM_POSTGRES_DATABASE_SET", bool(dbname))
        out("PLATFORM_POSTGRES_USER_SET", bool(dbuser))
    else:
        raise RuntimeError(f"Unsupported platform database backend: {backend}")

    ptables = set(inspect(platform_engine).get_table_names())
    required = {
        "users",
        "trading_accounts",
        "licenses",
        "subscriptions",
        "trade_records",
        "notifications",
        "audit_events",
    }
    missing = sorted(required - ptables)
    if missing:
        raise RuntimeError("Platform tables missing: " + ",".join(missing))

    bridge_tables = set(sqlite_tables(bp))
    required_bridge = {"executions", "execution_claims", "position_meta"}
    missing_bridge = sorted(required_bridge - bridge_tables)
    if missing_bridge:
        raise RuntimeError(
            "Bridge persistence tables missing: " + ",".join(missing_bridge)
        )

    decision_tables = sqlite_tables(dp)
    if not decision_tables:
        raise RuntimeError("Decision database has no tables.")

    out("PLATFORM_REQUIRED_TABLES", "PASS")
    out("BRIDGE_PERSISTENCE_TABLES", "PASS")
    out("DECISION_DB_TABLES_PRESENT", "PASS")

    counts = platform_counts()
    for key, value in counts.items():
        out("PLATFORM_COUNT_" + key.upper(), value)

def mt5_snapshot(mt5_path: str, start_epoch: int):
    import MetaTrader5 as mt5

    ok = mt5.initialize(path=mt5_path)
    out("MT5_PROBE_INIT", bool(ok))
    if not ok:
        raise RuntimeError(f"MT5 initialize failed: {mt5.last_error()}")

    try:
        ti = mt5.terminal_info()
        ai = mt5.account_info()
        if not (ti and ti.connected and ai):
            raise RuntimeError("MT5 is not connected.")

        expected = str(getattr(bridge_settings, "expected_server", "") or "")
        if expected and str(ai.server) != expected:
            raise RuntimeError("MT5 expected server mismatch.")

        magic = int(getattr(bridge_settings, "magic", 400040))
        positions = mt5.positions_get()
        if positions is None:
            raise RuntimeError("MT5 positions query failed.")

        magic_positions = [
            p for p in positions
            if int(getattr(p, "magic", 0) or 0) == magic
        ]

        from datetime import datetime, timezone

        deals = mt5.history_deals_get(
            datetime.fromtimestamp(start_epoch, tz=timezone.utc),
            datetime.now(timezone.utc),
        )
        if deals is None:
            raise RuntimeError("MT5 history query failed.")

        magic_deals = [
            d for d in deals
            if int(getattr(d, "magic", 0) or 0) == magic
        ]

        out("MT5_CONNECTED", True)
        out("MT5_TERMINAL_TRADE_ALLOWED", bool(ti.trade_allowed))
        out("MT5_ABUTRON_MAGIC_POSITIONS", len(magic_positions))
        out("MT5_ABUTRON_MAGIC_DEALS_SINCE_START", len(magic_deals))

        # Step 15 is deliberately a zero-state restart reconciliation gate.
        # Open-position/ticket reconciliation is certified later in the
        # broker demo lifecycle once real Abutron demo positions exist.
        if magic_positions:
            raise RuntimeError(
                "Step 15 requires zero current Abutron-magic positions."
            )
        if magic_deals:
            raise RuntimeError(
                "Abutron-magic deals appeared during Step 15."
            )

        out("MT5_ZERO_STATE_RECONCILIATION", "PASS")
    finally:
        mt5.shutdown()


def cmd_preflight(args):
    inventory()
    create_markers(args.marker)
    backup_restore_drill(args.marker, Path(args.backup_dir))
    mt5_snapshot(args.mt5_path, args.start_epoch)
    out("STEP15_HELPER_PREFLIGHT", "PASS")


def cmd_verify(args):
    inventory()
    verify_markers(args.marker)
    mt5_snapshot(args.mt5_path, args.start_epoch)
    out("STEP15_HELPER_POST_RESTART_VERIFY", "PASS")


def cmd_cleanup(args):
    cleanup_markers(args.marker)
    out("STEP15_HELPER_CLEANUP", "PASS")


def cmd_final_audit(args):
    final_audit(args.marker)
    out("STEP15_HELPER_FINAL_AUDIT", "PASS")


def cmd_verify_final(args):
    inventory()
    verify_final(args.marker)
    mt5_snapshot(args.mt5_path, args.start_epoch)
    out("STEP15_HELPER_FINAL_VERIFY", "PASS")


def main():
    p = argparse.ArgumentParser()
    p.add_argument(
        "command",
        choices=(
            "preflight",
            "verify",
            "cleanup",
            "final-audit",
            "verify-final",
        ),
    )
    p.add_argument("--marker", required=True)
    p.add_argument("--backup-dir", default="")
    p.add_argument("--mt5-path", required=True)
    p.add_argument("--start-epoch", required=True, type=int)
    args = p.parse_args()

    if args.command == "preflight":
        if not args.backup_dir:
            raise RuntimeError("--backup-dir is required for preflight.")
        cmd_preflight(args)
    elif args.command == "verify":
        cmd_verify(args)
    elif args.command == "cleanup":
        cmd_cleanup(args)
    elif args.command == "final-audit":
        cmd_final_audit(args)
    elif args.command == "verify-final":
        cmd_verify_final(args)


if __name__ == "__main__":
    main()
