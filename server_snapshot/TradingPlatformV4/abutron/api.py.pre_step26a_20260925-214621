@app.post("/v1/accounts")
def add_account(body:TradingAccountBody,user=Depends(current_user)):
    with session_scope() as s:
        a=TradingAccount(user_id=user.id,broker=body.broker,login=body.login,server=body.server,symbol=body.symbol.upper())
        s.add(a); s.flush(); aid=a.id
    audit("TRADING_ACCOUNT_ADDED",str(aid),actor=user.email)
    return {"id":aid,"created":True}

@app.get("/v1/mobile/dashboard")
def mobile_dashboard(user=Depends(current_user)):
    with session_scope() as s:
        accounts=s.scalars(select(TradingAccount).where(TradingAccount.user_id==user.id)).all()
        licenses=s.scalars(select(License).where(License.user_id==user.id)).all()
        subs=s.scalars(select(Subscription).where(Subscription.user_id==user.id)).all()
        notes=s.scalars(select(Notification).where(Notification.user_id==user.id).order_by(Notification.id.desc()).limit(20)).all()
