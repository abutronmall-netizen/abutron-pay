@asynccontextmanager
async def lifespan(app:FastAPI):
    init_db()

    # ABUTRON_KRONOS_WARMLOAD_V1
    #
    # Production readiness invariant:
    # FUSION / KRONOS mode must have the Kronos
    # predictor loaded before the API advertises
    # readiness.
    if str(settings.core_mode).upper() in {
        "FUSION",
        "KRONOS",
    }:
        svc.kronos._load()
    if not settings.admin_bootstrap_password.startswith("CHANGE_ME") and not settings.jwt_secret.startswith("CHANGE_ME"):
        with session_scope() as s:
            u=s.scalar(select(User).where(User.email==settings.admin_bootstrap_email.lower()))
            if not u:
                s.add(User(email=settings.admin_bootstrap_email.lower(),full_name="Abutron Administrator",
                           password_hash=hash_password(settings.admin_bootstrap_password),role="superadmin",active=True))
    yield

app=FastAPI(title="ABUTRON TRADING PLATFORM",version=__version__,lifespan=lifespan)

def internal_auth(authorization):
    if settings.api_token.startswith("CHANGE_ME"): raise HTTPException(503,"Configure ABUTRON_API_TOKEN")
    if authorization!=f"Bearer {settings.api_token}": raise HTTPException(401,"Unauthorized")

def serial(x):
    if hasattr(x,"model_dump"): return x.model_dump(mode="json")
    if isinstance(x,dict): return {k:serial(v) for k,v in x.items()}
    if isinstance(x,list): return [serial(v) for v in x]
    return x

@app.get("/health")
async def health():
    mt5={"status":"unknown"}
    try: mt5=await svc.gateway.health()
    except Exception as e: mt5={"status":"degraded","error":str(e)}
    db_ok=True
    try:
        with session_scope() as s: s.scalar(select(func.count()).select_from(User))
    except Exception: db_ok=False
    return {"status":"ok" if db_ok else "degraded","version":__version__,"mode":settings.core_mode,
            "execution_enabled":settings.execution_enabled,"symbols":settings.symbol_list,
            "kronos_loaded":svc.kronos.predictor is not None,"database":db_ok,"mt5":mt5}

