            "accounts":[{"id":a.id,"broker":a.broker,"login":a.login,"server":a.server,"symbol":a.symbol,"current_tier":a.current_tier,"active":a.active} for a in accounts],
            "licenses":[{"product":x.product,"status":x.status,"expires_ts":x.expires_ts} for x in licenses],
            "subscriptions":[{"plan":x.plan,"status":x.status,"external_ref":x.external_ref} for x in subs],
            "notifications":[{"id":n.id,"title":n.title,"body":n.body,"channel":n.channel,"state":n.state,"created_ts":n.created_ts} for n in notes]}

