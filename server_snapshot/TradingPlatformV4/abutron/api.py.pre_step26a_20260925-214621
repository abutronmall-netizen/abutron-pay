@app.put("/v1/admin/licenses/{user_id}")
def set_license(user_id:int,body:LicenseStateBody,admin=Depends(require_admin)):
    allowed={"pending","active","suspended","expired","revoked"}
    if body.status not in allowed: raise HTTPException(400,"Invalid license status")
    with session_scope() as s:
        lic=s.scalar(select(License).where(License.user_id==user_id).order_by(License.id.desc()))
        if not lic:
            lic=License(user_id=user_id,product="ABUTRON_V4",status=body.status,expires_ts=body.expires_ts); s.add(lic)
        else:
            lic.status=body.status; lic.expires_ts=body.expires_ts
    audit("LICENSE_STATE_CHANGED",str(user_id),body.status,admin.email)
    return {"updated":True,"user_id":user_id,"status":body.status}

@app.post("/v1/admin/subscriptions/{user_id}")
def set_subscription(user_id:int,body:SubscriptionBody,admin=Depends(require_admin)):
    with session_scope() as s:
        sub=Subscription(user_id=user_id,plan=body.plan,status=body.status,external_ref=body.external_ref,updated_ts=int(time.time()))
        s.add(sub); s.flush(); sid=sub.id
    audit("SUBSCRIPTION_CREATED",str(sid),body.status,admin.email)
    return {"id":sid,"created":True}

@app.get("/v1/admin/audit")
def admin_audit(limit:int=200,admin=Depends(require_admin)):
    with session_scope() as s: rows=s.scalars(select(AuditEvent).order_by(AuditEvent.id.desc()).limit(max(1,min(limit,1000)))).all()
