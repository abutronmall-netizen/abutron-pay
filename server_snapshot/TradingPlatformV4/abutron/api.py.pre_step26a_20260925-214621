@app.post("/v1/auth/register")
def register(body:RegisterBody):
    if not body.terms_accepted or not body.risk_accepted:
        raise HTTPException(400,"Terms and trading-risk acceptance are required")
    email=str(body.email).lower()
    with session_scope() as s:
        if s.scalar(select(User).where(User.email==email)): raise HTTPException(409,"Email already registered")
        u=User(email=email,full_name=body.full_name.strip(),phone=body.phone.strip(),password_hash=hash_password(body.password),role="customer",active=True)
        s.add(u); s.flush()
        s.add(License(user_id=u.id,product="ABUTRON_V4",status="pending"))
        uid=u.id
    audit("USER_REGISTERED",str(uid),actor=email)
    return {"registered":True,"user_id":uid,"license_status":"pending"}

@app.post("/v1/auth/login")
def login(body:LoginBody):
    with session_scope() as s:
        u=s.scalar(select(User).where(User.email==str(body.email).lower()))
        if not u or not u.active or not verify_password(body.password,u.password_hash): raise HTTPException(401,"Invalid credentials")
        token=issue_token(u)
        return {"access_token":token,"token_type":"bearer","expires_in":3600,"role":u.role,"user_id":u.id}

