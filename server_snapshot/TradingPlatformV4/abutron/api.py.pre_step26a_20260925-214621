@app.get("/v1/mobile/trades")
def mobile_trades(
    limit:int=100,
    user=Depends(current_user),
):
    limit=max(
        1,
        min(
            limit,
            500,
        ),
    )

    with session_scope() as s:
        ids=[
            x.id
            for x in s.scalars(
                select(TradingAccount)
                .where(
                    TradingAccount.user_id
                    == user.id
                )
            ).all()
        ]

        if not ids:
            return []

        rows=s.scalars(
            select(TradeRecord)
            .where(
                TradeRecord.account_id.in_(
                    ids
                )
            )
            .order_by(
                TradeRecord.id.desc()
            )
            .limit(limit)
        ).all()

        return [
            _trade_dict(x)
            for x in rows
        ]


@app.get("/v1/admin/trades")
def admin_trades(
    limit:int=200,
    state:str|None=None,
    account_id:int|None=None,
    admin=Depends(require_admin),
):
    limit=max(
        1,
        min(
            limit,
            1000,
        ),
    )

    with session_scope() as s:
        stmt=select(
            TradeRecord
        )

        if state:
            stmt=stmt.where(
                TradeRecord.state
                == state.upper()
            )

        if account_id is not None:
            stmt=stmt.where(
                TradeRecord.account_id
                == account_id
            )

        rows=s.scalars(
            stmt
            .order_by(
                TradeRecord.id.desc()
            )
            .limit(limit)
        ).all()

        return [
            _trade_dict(x)
            for x in rows
        ]


