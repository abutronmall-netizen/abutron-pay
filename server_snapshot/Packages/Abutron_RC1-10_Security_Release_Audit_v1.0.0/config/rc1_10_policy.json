        "*.py"
      ]
    },
    {
      "path": "C:\\Abutron\\TradingPlatformV4\\mt5_bridge",
      "patterns": [
        "*.py"
      ]
    },
    {
      "path": "C:\\Abutron\\TradingPlatformV4\\ctrader_cloud_gateway",
      "patterns": [
        "*.py"
      ]
    },
    {
      "path": "C:\\Abutron\\Jarvis\\rc1_08",
      "patterns": [
        "*.py"
      ]
    },
    {
      "path": "C:\\Abutron\\Jarvis\\rc1_09",
      "patterns": [
        "*.py"
      ]
    },
    {
