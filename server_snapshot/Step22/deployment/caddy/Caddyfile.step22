{
    admin 127.0.0.1:2019
}

api.abutronfx.online {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    handle /healthz {
        respond "ok" 200
    }

    @oauth_start {
        path /v1/ctrader/oauth/start*
        method GET
    }
    handle @oauth_start {
        reverse_proxy 127.0.0.1:8091
    }

    @oauth_callback {
        path /v1/ctrader/oauth/callback*
        method GET
    }
    handle @oauth_callback {
        reverse_proxy 127.0.0.1:8091
    }

    @auth_register {
        path /v1/auth/register
        method POST
    }
    handle @auth_register {
        reverse_proxy 127.0.0.1:8088
    }

    @auth_login {
        path /v1/auth/login
        method POST
    }
    handle @auth_login {
        reverse_proxy 127.0.0.1:8088
    }

    @me {
        path /v1/me
        method GET
    }
    handle @me {
        reverse_proxy 127.0.0.1:8088
    }

    @account_add {
        path /v1/accounts
        method POST
    }
    handle @account_add {
        reverse_proxy 127.0.0.1:8088
    }

    @mobile_dashboard {
        path /v1/mobile/dashboard
        method GET
    }
    handle @mobile_dashboard {
        reverse_proxy 127.0.0.1:8088
    }

    @mobile_trades {
        path /v1/mobile/trades
        method GET
    }
    handle @mobile_trades {
        reverse_proxy 127.0.0.1:8088
    }

    @ic_connect {
        path /v1/broker/ic-markets/connect
        method POST DELETE
    }
    handle @ic_connect {
        reverse_proxy 127.0.0.1:8088
    }

    @ic_accounts {
        path /v1/broker/ic-markets/accounts
        method GET
    }
    handle @ic_accounts {
        reverse_proxy 127.0.0.1:8088
    }

    @ic_accounts_refresh {
        path /v1/broker/ic-markets/accounts/refresh
        method POST
    }
    handle @ic_accounts_refresh {
        reverse_proxy 127.0.0.1:8088
    }

    @ic_discovery {
        path /v1/broker/ic-markets/accounts/*/discovery
        method GET
    }
    handle @ic_discovery {
        reverse_proxy 127.0.0.1:8088
    }

    # Default deny: future routes are private until deliberately allowlisted.
    handle {
        respond "Not Found" 404
    }
}
